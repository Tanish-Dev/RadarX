# Database — local file by default; for Turso use libsql://<db>-<org>.turso.io
DATABASE_URL=file:data/radar.db
DATABASE_AUTH_TOKEN=

# Worker
POLL_INTERVAL_MIN=5
POLL_CONCURRENCY=8
# Postings older than this (by source posted date) are stored silently instead of alerted
FRESH_WINDOW_HOURS=72
# SimplifyJobs repos (roll over each season)
SIMPLIFY_REPOS=SimplifyJobs/Summer2027-Internships,SimplifyJobs/New-Grad-Positions

# Alerts — create a bot with @BotFather, message it, then `npm run telegram:setup` prints the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# optional second channel (Server settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=
# public https URL of the dashboard (adds "Open in RadarX" buttons); leave empty locally
DASHBOARD_URL=

# Stock watchlist (optional) — free key from https://twelvedata.com/pricing (Basic: 800 credits/day, 8/min)
TWELVEDATA_API_KEY=
# STOCK_INTERVAL_MIN=30
# NEWS_INTERVAL_MIN=20
# PROGRAM_INTERVAL_HOURS=6

# Hosted dashboard (Vercel) → "Poll now" triggers the GitHub Actions worker.
# Fine-grained token on this repo with "Actions: Read and write"; GH_REPO = owner/name
GH_DISPATCH_TOKEN=
GH_REPO=

# Debug: print rows written/returned per worker run (the free-tier budget on Turso)
# RADAR_DB_STATS=1
